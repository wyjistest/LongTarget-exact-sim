FROM scratch

COPY rootfs /

ENV PATH=/usr/bin:/opt/gasal2/bin \
    LD_LIBRARY_PATH=/usr/local/cuda/targets/x86_64-linux/lib:/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    GASAL2_GPU_SCREEN_RUNTIME_IDENTITY=/opt/gasal2/runtime_identity.json

WORKDIR /work
ENTRYPOINT ["/usr/bin/python3.11", "/opt/gasal2/gasal2_gpu_screen.py"]
