{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gasal2-longtarget:contracts:1.0.0",
  "title": "GASAL2-LongTarget pre-holdout contract registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_version",
    "submission_software_epoch",
    "paper_runtime_commit",
    "paper_data_freeze",
    "registry_state",
    "holdout_freeze_id",
    "contracts"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "registry_version": {"type": "string", "minLength": 1},
    "submission_software_epoch": {"type": "integer", "minimum": 1},
    "paper_runtime_commit": {"type": "string", "minLength": 1},
    "paper_data_freeze": {"type": "string", "minLength": 1},
    "registry_state": {"const": "pre_holdout_freeze"},
    "holdout_freeze_id": {"type": "string", "minLength": 1},
    "contracts": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract_id",
          "status",
          "output_definition",
          "required_preset",
          "input_guards",
          "runtime_guards",
          "authority_definition",
          "validation_datasets",
          "clean_mismatch_counts",
          "known_limitations"
        ],
        "properties": {
          "contract_id": {
            "enum": ["score_top5_v1", "all_ranked_top5_v1", "full_output_v1"]
          },
          "status": {"const": "experimental"},
          "output_definition": {"type": "string", "minLength": 1},
          "required_preset": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rule", "triplex_preset", "top_k", "output_mode"],
            "properties": {
              "rule": {"const": 0},
              "triplex_preset": {"const": "normal"},
              "top_k": {"const": 5},
              "output_mode": {"const": "tfosorted"}
            }
          },
          "input_guards": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "canonical_acgt",
              "query_record_count",
              "target_record_count",
              "query_length_max_nt"
            ],
            "properties": {
              "canonical_acgt": {"const": true},
              "query_record_count": {"const": 1},
              "target_record_count": {"const": 1},
              "query_length_max_nt": {"const": 2812}
            }
          },
          "runtime_guards": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "compute_capability",
              "minimum_gpu_memory_mib",
              "worker_density",
              "fallback_on_unknown_state"
            ],
            "properties": {
              "compute_capability": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "minimum_gpu_memory_mib": {"type": "integer", "minimum": 1},
              "worker_density": {"type": "integer", "minimum": 1},
              "fallback_on_unknown_state": {"const": true}
            }
          },
          "authority_definition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "backend",
              "runtime_commit",
              "comparator",
              "cluster_distance",
              "cluster_length"
            ],
            "properties": {
              "backend": {"type": "string", "minLength": 1},
              "runtime_commit": {"type": "string", "minLength": 1},
              "comparator": {"type": "string", "minLength": 1},
              "cluster_distance": {"type": "integer", "minimum": 0},
              "cluster_length": {"type": "integer", "minimum": 1}
            }
          },
          "validation_datasets": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["dataset_id", "role", "status", "query_count", "workload_count"],
              "properties": {
                "dataset_id": {"type": "string", "minLength": 1},
                "role": {"enum": ["development", "independent_holdout"]},
                "status": {
                  "enum": ["complete", "preregistered_not_run", "complete_with_results"]
                },
                "query_count": {"type": ["integer", "null"], "minimum": 0},
                "workload_count": {"type": ["integer", "null"], "minimum": 0}
              }
            }
          },
          "clean_mismatch_counts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["development", "holdout"],
            "properties": {
              "development": {
                "type": "object",
                "additionalProperties": false,
                "required": ["clean", "mismatch", "rank_counts"],
                "properties": {
                  "clean": {"type": "integer", "minimum": 0},
                  "mismatch": {"type": "integer", "minimum": 0},
                  "rank_counts": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["score", "stability", "nt"],
                    "properties": {
                      "score": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["clean", "mismatch"],
                        "properties": {
                          "clean": {"type": "integer", "minimum": 0},
                          "mismatch": {"type": "integer", "minimum": 0}
                        }
                      },
                      "stability": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["clean", "mismatch"],
                        "properties": {
                          "clean": {"type": "integer", "minimum": 0},
                          "mismatch": {"type": "integer", "minimum": 0}
                        }
                      },
                      "nt": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["clean", "mismatch"],
                        "properties": {
                          "clean": {"type": "integer", "minimum": 0},
                          "mismatch": {"type": "integer", "minimum": 0}
                        }
                      }
                    }
                  }
                }
              },
              "holdout": {
                "type": "object",
                "additionalProperties": false,
                "required": ["clean", "mismatch", "rank_counts"],
                "properties": {
                  "clean": {"type": ["integer", "null"], "minimum": 0},
                  "mismatch": {"type": ["integer", "null"], "minimum": 0},
                  "rank_counts": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["score", "stability", "nt"],
                    "properties": {
                      "score": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["clean", "mismatch"],
                        "properties": {
                          "clean": {"type": ["integer", "null"], "minimum": 0},
                          "mismatch": {"type": ["integer", "null"], "minimum": 0}
                        }
                      },
                      "stability": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["clean", "mismatch"],
                        "properties": {
                          "clean": {"type": ["integer", "null"], "minimum": 0},
                          "mismatch": {"type": ["integer", "null"], "minimum": 0}
                        }
                      },
                      "nt": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["clean", "mismatch"],
                        "properties": {
                          "clean": {"type": ["integer", "null"], "minimum": 0},
                          "mismatch": {"type": ["integer", "null"], "minimum": 0}
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "known_limitations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
